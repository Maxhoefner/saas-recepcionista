# ── General ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Used by docker-compose to create the local DB, and by the API to connect.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_receptionist
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_receptionist

# ── Redis (job queue, rate limiting, webhook idempotency locks) ────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Encrypts third-party credentials at rest (e.g. WhatsApp access tokens).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Frontend (apps/web) ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── AI provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AGENT_MAX_TOOL_ITERATIONS=5

# ── WhatsApp Cloud API ───────────────────────────────────────────────────────
# WHATSAPP_VERIFY_TOKEN: elegís vos cualquier string; lo repetís al registrar
# el webhook en la Meta App Dashboard. WHATSAPP_APP_SECRET: viene del panel
# de la App en Meta (App Settings > Basic). El access token de cada negocio
# se carga por API (PUT /businesses/{id}/whatsapp-account), no acá.
WHATSAPP_PROVIDER=meta
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
